@startuml
' Sơ đồ quan hệ giữa các màn hình chính của Pet Shop App
skinparam backgroundColor #f9f9f9
skinparam rectangle {
  BackgroundColor #e3f2fd
  BorderColor #1976d2
  FontColor #0d47a1
}
skinparam package {
  BackgroundColor #fffde7
  BorderColor #fbc02d
  FontColor #f57c00
}
left to right direction

package "MOBILE APP (USER)" as UserApp {
  rectangle LoginOrRegister
  rectangle LoginPage
  rectangle RegisterPage
  rectangle VerifyEmailPage
  rectangle BottomNavigator
  rectangle HomePage
  rectangle FavoriteScreen
  rectangle CartScreen
  rectangle ProfileScreen
  rectangle AllPet
  rectangle DetailPet
  rectangle PetItems
  rectangle PetItemsAll
  rectangle OrderSuccess
  rectangle YourOrderScreen
  rectangle EditProfile
  rectangle ChangePasswordPage
  rectangle ChatPage
  rectangle StoreInfoScreen
}

package "WEB ADMIN" as AdminWeb {
  rectangle HomePageAdmin
  rectangle PetsAdmin
  rectangle CategoryAdmin
  rectangle AccountAdmin
  rectangle OrdersAdmin
  rectangle InboxPageAdmin
  rectangle ShopInfo
  rectangle RevenuePage
  rectangle ChatDetailPage
  rectangle SendEmail
}

' USER FLOW
LoginOrRegister --> LoginPage
LoginOrRegister --> RegisterPage
LoginPage --> BottomNavigator
RegisterPage --> VerifyEmailPage
VerifyEmailPage --> BottomNavigator

BottomNavigator --> HomePage
BottomNavigator --> FavoriteScreen
BottomNavigator --> CartScreen
BottomNavigator --> ProfileScreen

HomePage --> AllPet
HomePage --> DetailPet
HomePage --> PetItems
HomePage --> PetItemsAll

FavoriteScreen --> DetailPet
CartScreen --> OrderSuccess
CartScreen --> DetailPet
OrderSuccess --> YourOrderScreen
OrderSuccess --> DetailPet

ProfileScreen --> FavoriteScreen
ProfileScreen --> EditProfile
ProfileScreen --> ChangePasswordPage
ProfileScreen --> ChatPage
ProfileScreen --> YourOrderScreen
ProfileScreen --> LoginOrRegister : <<Logout>>

YourOrderScreen --> DetailPet
StoreInfoScreen --> ChatPage

' ADMIN FLOW
LoginOrRegister --> HomePageAdmin
HomePageAdmin --> PetsAdmin
HomePageAdmin --> CategoryAdmin
HomePageAdmin --> AccountAdmin
HomePageAdmin --> OrdersAdmin
HomePageAdmin --> InboxPageAdmin
HomePageAdmin --> ShopInfo
HomePageAdmin --> RevenuePage
HomePageAdmin --> LoginOrRegister : <<Logout>>

InboxPageAdmin --> ChatDetailPage
AccountAdmin --> OrdersAdmin
OrdersAdmin --> SendEmail

@enduml