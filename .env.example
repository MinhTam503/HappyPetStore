# Happy Pets Store Information
# 🧪 GoSHIP Test Environment Configuration
# Copy this file to .env and update with your test credentials

# Shipping Service Configuration
# Set to true to use GoSHIP Staging API, false to use Mock API
USE_GOSHIP=true

# GoSHIP Test/Staging Configuration
# Get these credentials from https://merchants-staging.goship.io/
GOSHIP_BASE_URL=https://api-staging.goship.io
GOSHIP_API_KEY=LnlDHp4B2a9jYGQsgMOM2Xsz6vvrLA91UrvxnRti

# Store Information for Testing (can use fake data)
STORE_NAME=Happy Pets Store (Test)
STORE_ADDRESS=123 Test Street, Thủ Đức, TP.HCM
STORE_PHONE=0123456789
STORE_EMAIL=test@happypets.com

# ⚠️ IMPORTANT NOTES:
# - This is for TESTING/LEARNING purposes only
# - No real money transactions in test environment
# - API key must start with "gs_test_" for staging
# - Use fake customer data for testing
# - Staging API may go down for maintenance occasionally
# - App will automatically fallback to Mock API if staging fails

# 🚀 Quick Setup:
# 1. Register at https://merchants-staging.goship.io/
# 2. Get your test API key from dashboard
# 3. Replace gs_test_your_staging_api_key_here with your real test key
# 4. Save this file as .env (remove .example)
# 5. Run flutter app and test shipping features!

# 📚 For Development (offline testing):
# Set USE_GOSHIP=false to use built-in Mock API
# No internet connection required for Mock API

# Firebase Configuration (if needed)
# FIREBASE_API_KEY=your_firebase_key
# FIREBASE_PROJECT_ID=your_project_id

# Debug Mode
DEBUG_MODE=true